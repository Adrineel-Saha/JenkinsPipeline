pipeline {
  agent any

  environment {
    JDK_HOME = tool name: 'JDK17', type: 'jdk'
    MVN_HOME = tool name: 'Maven3', type: 'maven'
    // ORDER_PORT will be read from application.yml
  }

  stages {

    stage('Clone Repository') {
      steps {
        git url: 'https://github.com/Adrineel-Saha/OrderService.git', branch: 'main'
      }
    }

    // ---------------------------------------
    // ✅ Read server.port from application.yml
    // ---------------------------------------
    stage('Read Port from application.yml') {
      steps {
        script {
          def ymlPath = 'src/main/resources/application.yml'
          if (!fileExists(ymlPath)) {
            error "application.yml not found at ${ymlPath}"
          }

          def yml = readFile ymlPath
          def m = (yml =~ /(?m)^server:\s*(?:\r?\n|\r)\s*port:\s*(\d+)\s*$/)

          if (m.find()) {
            env.ORDER_PORT = m.group(1)
            echo "Using server.port from application.yml: ${env.ORDER_PORT}"
          } else {
            error "server.port not found in application.yml"
          }
        }
      }
    }

    // ---------------------------------------
    // ✅ Kill old instance by PORT
    // ---------------------------------------
    stage('Kill Old Instance') {
      steps {
        bat '''
          @echo on
          echo === Kill (pre-build): checking port %ORDER_PORT% ===
          set "FOUND="
          for /f "tokens=5" %%p in (
            'netstat -ano ^| findstr /r /c:":%ORDER_PORT%[ ]"'
          ) do (
            set FOUND=1
            echo Found PID %%p on port %ORDER_PORT% - killing
            taskkill /F /PID %%p >nul 2>&1
          )
          if not defined FOUND (
            echo No process bound to port %ORDER_PORT%
          )
          exit /b 0
        '''
      }
    }

    // ---------------------------------------
    // ✅ Compile
    // ---------------------------------------
    stage('Compile') {
      steps {
        withEnv([
          "JAVA_HOME=${env.JDK_HOME}",
          "M2_HOME=${env.MVN_HOME}",
          "PATH+JAVA=${env.JDK_HOME}\\bin",
          "PATH+MAVEN=${env.MVN_HOME}\\bin",
          "MAVEN_OPTS=-Xmx1024m -Dfile.encoding=UTF-8"
        ]) {
          script {
            def mvnCmd = fileExists('mvnw.cmd') ? 'mvnw.cmd' : '"%M2_HOME%\\bin\\mvn.cmd"'
            bat 'echo === Compile ==='
            bat '"%JAVA_HOME%\\bin\\java.exe" -version'
            bat "call ${mvnCmd} -B -e -DskipTests compile"
          }
        }
      }
    }

    // ---------------------------------------
    // ✅ Unit Tests
    // ---------------------------------------
    stage('Unit Tests') {
      steps {
        withEnv([
          "JAVA_HOME=${env.JDK_HOME}",
          "M2_HOME=${env.MVN_HOME}",
          "PATH+JAVA=${env.JDK_HOME}\\bin",
          "PATH+MAVEN=${env.MVN_HOME}\\bin"
        ]) {
          script {
            def mvnCmd = fileExists('mvnw.cmd') ? 'mvnw.cmd' : '"%M2_HOME%\\bin\\mvn.cmd"'
            bat 'echo === Unit Tests ==='
            bat "call ${mvnCmd} -B -e test"
          }
        }
      }
    }

    // ---------------------------------------
    // ✅ Package
    // ---------------------------------------
    stage('Build (package)') {
      steps {
        withEnv([
          "JAVA_HOME=${env.JDK_HOME}",
          "M2_HOME=${env.MVN_HOME}",
          "PATH+JAVA=${env.JDK_HOME}\\bin",
          "PATH+MAVEN=${env.MVN_HOME}\\bin"
        ]) {
          script {
            def mvnCmd = fileExists('mvnw.cmd') ? 'mvnw.cmd' : '"%M2_HOME%\\bin\\mvn.cmd"'
            bat 'if exist target rmdir /s /q target'
            bat "call ${mvnCmd} -B -e clean package -DskipTests"

            bat 'if not exist target\\*.jar (echo ERROR: No jar produced & exit /b 1)'
          }
        }
      }
    }

    // ---------------------------------------
    // ✅ Run OrderService (port-known)
    // ---------------------------------------
    stage('Run OrderService') {
      steps {
        withEnv([
          "JAVA_HOME=${env.JDK_HOME}",
          "PATH+JAVA=${env.JDK_HOME}\\bin"
        ]) {
          bat '''
            @echo on
            setlocal enabledelayedexpansion

            echo === Resolve JAR ===
            for %%f in (target\\*.jar) do (
              set "SRC_JAR=%%~ff"
              goto :found
            )
            echo ERROR: No jar found
            exit /b 1
            :found

            rem Prepare run directory
            if exist run rmdir /s /q run
            mkdir run
            copy /Y "%SRC_JAR%" run\\OrderService.jar

            rem Prevent Jenkins from killing it
            set BUILD_ID=dontKillMe
            set JENKINS_NODE_COOKIE=do_not_kill

            echo === Starting OrderService on port %ORDER_PORT% ===
            start "" /b "%JAVA_HOME%\\bin\\java.exe" ^
              -jar "%CD%\\run\\OrderService.jar" ^
              --server.port=%ORDER_PORT%

            echo === Waiting for HTTP readiness ===
            set COUNT=0
            :wait_loop
            set /a COUNT+=1
            ping -n 2 127.0.0.1 >nul
            curl -s -o NUL http://127.0.0.1:%ORDER_PORT%/
            if not errorlevel 1 goto up
            if %COUNT% GEQ 60 goto fail
            goto wait_loop

            :up
            echo SUCCESS: OrderService is running on port %ORDER_PORT%
            exit /b 0

            :fail
            echo ERROR: OrderService did not start within 60 seconds
            exit /b 1
          '''
        }
      }
    }
  }

  post {
    always {
      echo "Pipeline finished. OrderService running on port ${env.ORDER_PORT} using Config Server for externalized config."
      // junit 'target/surefire-reports/*.xml'
    }
  }
}
