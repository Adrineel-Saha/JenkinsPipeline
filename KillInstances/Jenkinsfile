pipeline {
  agent any

  stages {

    stage('Clean Workspace') {
      steps {
        deleteDir()
      }
    }

    // -------------------------------------------------
    // Clone ONLY EurekaServer
    // -------------------------------------------------
    stage('Clone EurekaServer Repo') {
      steps {
        dir('eureka') {
          git url: 'https://github.com/Adrineel-Saha/EurekaServer.git', branch: 'main'
        }
      }
    }

    // -------------------------------------------------
    // Read Eureka server.port from application.yml
    // -------------------------------------------------
    stage('Read Eureka Port from application.yml') {
      steps {
        script {
          def yml = readFile('eureka/src/main/resources/application.yml')
          def m = (yml =~ /(?m)^server:\s*(?:\r?\n|\r)\s*port:\s*(\d+)\s*$/)
          if (!m.find()) error "server.port not found"
          env.EUREKA_PORT = m.group(1)
          echo "Eureka port: ${env.EUREKA_PORT}"
        }
      }
    }

    // -------------------------------------------------
    // Fetch Eureka registry (XML)
    // -------------------------------------------------
    stage('Fetch Eureka Registry') {
      steps {
        bat '''
          @echo on
          curl -s http://localhost:%EUREKA_PORT%/eureka/apps > apps.xml
        '''
      }
    }

    // -------------------------------------------------
    // Extract application names (SAFE)
    // -------------------------------------------------
    stage('Extract Services & Create Checkboxes') {
      steps {
        script {
          bat '''
            @echo off
            del services.txt >nul 2>&1

            rem Extract ONLY <application><name> values
            findstr "<application>" apps.xml > app_blocks.txt
            findstr "<name>" apps.xml | findstr /V "<hostName>" > raw_names.txt

            for /f "tokens=2 delims=<>" %%A in (raw_names.txt) do (
              echo %%A>>services.txt
            )
          '''

          def services = readFile('services.txt')
            .readLines()
            .collect { it.trim().toUpperCase() }
            .unique()

          def paramsList = []
          services.each { svc ->
            paramsList << booleanParam(
              name: "KILL_${svc}",
              defaultValue: false,
              description: "Kill all instances of ${svc}"
            )
          }

          properties([parameters(paramsList)])
          echo "Checkboxes created. Re-run using 'Build with Parameters'."
          currentBuild.result = 'SUCCESS'
          return
        }
      }
    }

    // -------------------------------------------------
    // Resolve ports for selected services
    // -------------------------------------------------
    stage('Resolve Selected Instances') {
      steps {
        script {
          bat '''
            @echo off
            del targets.txt >nul 2>&1

            rem Extract names and ports in order
            findstr "<name>" apps.xml | findstr /V "<hostName>" > names.txt
            findstr "<port>" apps.xml > ports.txt

            rem Pair name + port by line number
            setlocal EnableDelayedExpansion
            set i=0

            for /f "tokens=2 delims=<>" %%N in (names.txt) do (
              set /a i+=1
              for /f "tokens=2 delims=<>" %%P in ('more +!i! ports.txt ^| findstr "<port>"') do (
                echo %%N^|%%P>>targets.txt
                goto :next
              )
              :next
            )
            endlocal
          '''

          def selected = []
          def lines = fileExists('targets.txt') ? readFile('targets.txt').readLines() : []

          lines.each { line ->
            def parts = line.split('\\|')
            if (parts.size() == 2) {
              def app = parts[0].toUpperCase()
              def port = parts[1]
              if (params["KILL_${app}"]) {
                selected << "${app}|${port}"
              }
            }
          }

          writeFile file: 'final_targets.txt', text: selected.join('\n')
          env.HAS_TARGETS = selected ? 'yes' : ''
        }
      }
    }

    // -------------------------------------------------
    // Kill OS processes by PORT
    // -------------------------------------------------
    stage('Kill Processes') {
      when { expression { env.HAS_TARGETS == 'yes' } }
      steps {
        bat '''
          @echo on
          for /f "tokens=1,2 delims=|" %%A in (final_targets.txt) do (
            echo Killing %%A on port %%B
            for /f "tokens=5" %%P in (
              'netstat -ano ^| findstr LISTENING ^| findstr :%%B'
            ) do taskkill /F /PID %%P >nul 2>&1
          )
        '''
      }
    }

    // -------------------------------------------------
    // Deregister from Eureka
    // -------------------------------------------------
    stage('Deregister from Eureka') {
      when { expression { env.HAS_TARGETS == 'yes' } }
      steps {
        bat '''
          @echo on
          for /f "tokens=1,2 delims=|" %%A in (final_targets.txt) do (
            curl -s -X DELETE ^
              http://localhost:%EUREKA_PORT%/eureka/apps/%%A >nul 2>&1
          )
        '''
      }
    }
  }

  post {
    always {
      echo "KillInstances finished successfully (XML-only, sandbox-safe, stable)."
    }
  }
}
