pipeline {
  agent any

  stages {

    stage('Clean Workspace') {
      steps { deleteDir() }
    }

    stage('Clone EurekaServer Repo') {
      steps {
        dir('eureka') {
          git url: 'https://github.com/Adrineel-Saha/EurekaServer.git', branch: 'main'
        }
      }
    }

    stage('Read Eureka Port from application.yml') {
      steps {
        script {
          def yml = readFile('eureka/src/main/resources/application.yml')

          // ✅ DO NOT CHANGE REGEX
          def m = (yml =~ /(?m)^server:\s*(?:\r?\n|\r)\s*port:\s*(\d+)\s*$/)
          if (!m.find()) error "server.port not found"

          env.EUREKA_PORT = m.group(1)
          echo "Eureka port resolved: ${env.EUREKA_PORT}"
        }
      }
    }

    // -------------------------------------------------
    // ALWAYS fetch Eureka once per build
    // -------------------------------------------------
    stage('Fetch Eureka Registry (XML)') {
      steps {
        bat '''
          del apps.xml >nul 2>&1
          curl -s http://localhost:%EUREKA_PORT%/eureka/apps > apps.xml
        '''
      }
    }

    // -------------------------------------------------
    // ✅ CREATE CHECKBOXES (SINGLE SOURCE OF TRUTH)
    // -------------------------------------------------
    stage('Create Service Checkboxes') {
      steps {
        script {

          writeFile file: 'extract-services.ps1', text: '''
[xml]$x = Get-Content "apps.xml"

$x.applications.application |
Where-Object {
  $_.instance -ne $null -and
  ($_.instance | Where-Object { $_.status -eq "UP" })
} |
ForEach-Object { $_.name } |
Set-Content "services.txt"
'''
          bat 'powershell -NoProfile -ExecutionPolicy Bypass -File extract-services.ps1'

          def services = readFile('services.txt')
            .readLines()
            .collect { it.trim().toUpperCase() }
            .findAll { it }
            .unique()

          echo "Services at build start: ${services}"

          def paramsList = []

          if (services.isEmpty()) {
            paramsList << booleanParam(
              name: 'KILL_EUREKA',
              defaultValue: false,
              description: 'Kill Eureka Server'
            )
          }

          if (services == ['CONFIGSERVER']) {
            paramsList << booleanParam(
              name: 'KILL_CONFIGSERVER',
              defaultValue: false,
              description: 'Kill Config Server'
            )
          }

          services.findAll { it != 'CONFIGSERVER' }.each { svc ->
            paramsList << booleanParam(
              name: "KILL_${svc}",
              defaultValue: false,
              description: "Kill ${svc}"
            )
          }

          // ✅ Replace parameters (affects NEXT build)
          properties([
            [$class: 'ParametersDefinitionProperty',
             parameterDefinitions: paramsList]
          ])

          // ✅ FIRST BUILD → exit cleanly
          if (params.isEmpty()) {
            echo "ℹ First build initializes parameters. Re-run using 'Build with Parameters'."
            return
          }
        }
      }
    }

    // -------------------------------------------------
    // EXECUTION STAGES (SECOND BUILD ONWARD)
    // -------------------------------------------------
    stage('Resolve Selected Instances') {
      when { expression { !params.isEmpty() } }
      steps {
        script {

          writeFile file: 'resolve-targets.ps1', text: '''
[xml]$x = Get-Content "apps.xml"

$x.applications.application |
Where-Object { $_.instance -ne $null } |
ForEach-Object {
  $app = $_.name
  $_.instance | ForEach-Object {
    "$app|$($_.instanceId)|$($_.port.InnerText)"
  }
} | Set-Content "all_targets.txt"
'''
          bat 'powershell -NoProfile -ExecutionPolicy Bypass -File resolve-targets.ps1'

          def selected = []

          readFile('all_targets.txt').readLines().each { line ->
            def p = line.split('\\|')
            if (p.size() == 3 && params["KILL_${p[0].toUpperCase()}"]) {
              selected << "${p[0]}|${p[1]}|${p[2]}"
            }
          }

          writeFile file: 'final_targets.txt', text: selected.join('\n')
          env.HAS_TARGETS = selected ? 'yes' : ''
        }
      }
    }

    stage('Kill Processes') {
      when { expression { env.HAS_TARGETS == 'yes' } }
      steps {
        bat '''
          for /f "tokens=1,2,3 delims=|" %%A in (final_targets.txt) do (
            for /f "tokens=5" %%P in (
              'netstat -ano ^| findstr LISTENING ^| findstr :%%C'
            ) do taskkill /F /PID %%P >nul 2>&1
          )
          exit /b 0
        '''
      }
    }

    stage('Deregister from Eureka') {
      when { expression { env.HAS_TARGETS == 'yes' } }
      steps {
        bat '''
          for /f "tokens=1,2,3 delims=|" %%A in (final_targets.txt) do (
            curl -s -X DELETE ^
              http://localhost:%EUREKA_PORT%/eureka/apps/%%A/%%B >nul 2>&1
          )
        '''
      }
    }
  }

  post {
    always {
      echo "✅ KillInstances finished successfully."
    }
  }
}
