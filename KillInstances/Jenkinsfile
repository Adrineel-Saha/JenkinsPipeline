pipeline {
  agent any

  stages {

    stage('Clean Workspace') {
      steps {
        deleteDir()
      }
    }

    // -------------------------------------------------
    // Clone ONLY EurekaServer
    // -------------------------------------------------
    stage('Clone EurekaServer Repo') {
      steps {
        dir('eureka') {
          git url: 'https://github.com/Adrineel-Saha/EurekaServer.git', branch: 'main'
        }
      }
    }

    // -------------------------------------------------
    // Read Eureka server.port from application.yml
    // -------------------------------------------------
    stage('Read Eureka Port from application.yml') {
      steps {
        script {
          def yml = readFile('eureka/src/main/resources/application.yml')
          def m = (yml =~ /(?m)^server:\s*(?:\r?\n|\r)\s*port:\s*(\d+)\s*$/)
          if (!m.find()) {
            error "server.port not found in Eureka application.yml"
          }
          env.EUREKA_PORT = m.group(1)
          echo "Eureka port resolved."
        }
      }
    }

    // -------------------------------------------------
    // Fetch Eureka registry (XML)
    // -------------------------------------------------
    stage('Fetch Eureka Registry (XML)') {
      steps {
        bat '''
          curl -s http://localhost:%EUREKA_PORT%/eureka/apps > apps.xml
        '''
      }
    }

    // -------------------------------------------------
    // Create checkboxes (NEXT BUILD defaults)
    // -------------------------------------------------
    stage('Create Service Checkboxes') {
      steps {
        script {

          // Extract service names using PowerShell XML
          bat '''
            powershell -NoProfile -Command ^
              "[xml]$x = Get-Content apps.xml;" ^
              "$x.applications.application | ForEach-Object { $_.name } | Set-Content services.txt"
          '''

          def services = readFile('services.txt')
            .readLines()
            .collect { it.trim().toUpperCase() }
            .findAll { it }
            .unique()

          echo "Services currently in Eureka: ${services}"

          def paramsList = []

          // -------------------------------------------------
          // Eureka checkbox
          // Enabled by default ONLY if no services exist
          // -------------------------------------------------
          paramsList << booleanParam(
            name: 'KILL_EUREKA',
            defaultValue: services.isEmpty(),
            description: 'Kill Eureka Server'
          )

          // -------------------------------------------------
          // Config Server checkbox
          // Enabled by default ONLY if it is the only service
          // -------------------------------------------------
          paramsList << booleanParam(
            name: 'KILL_CONFIGSERVER',
            defaultValue: (services == ['CONFIGSERVER']),
            description: 'Kill Config Server'
          )

          // -------------------------------------------------
          // Other services (always unchecked by default)
          // -------------------------------------------------
          services.findAll { it != 'CONFIGSERVER' }.each { svc ->
            paramsList << booleanParam(
              name: "KILL_${svc}",
              defaultValue: false,
              description: "Kill ${svc}"
            )
          }

          // 🔴 IMPORTANT: clear existing parameters first
          properties([])

          // Apply parameters for NEXT build
          properties([parameters(paramsList)])

          echo "✅ Parameters reset and recreated for next build."
          currentBuild.result = 'SUCCESS'
          return
        }
      }
    }

    // -------------------------------------------------
    // Resolve ports for selected services
    // -------------------------------------------------
    stage('Resolve Selected Instances') {
      steps {
        script {

          bat '''
            powershell -NoProfile -Command ^
              "[xml]$x = Get-Content apps.xml;" ^
              "$x.applications.application | ForEach-Object { " ^
              "  $app=$_.name; " ^
              "  $_.instance | ForEach-Object { \"$app|$($_.port)\" } " ^
              "} | Set-Content all_targets.txt"
          '''

          def selected = []

          // Eureka explicitly
          if (params.KILL_EUREKA) {
            selected << "EUREKA|${env.EUREKA_PORT}"
          }

          // Other services
          readFile('all_targets.txt').readLines().each { line ->
            def parts = line.split('\\|')
            if (parts.size() == 2) {
              def app = parts[0].toUpperCase()
              def port = parts[1]
              if (params["KILL_${app}"]) {
                selected << "${app}|${port}"
              }
            }
          }

          writeFile file: 'final_targets.txt', text: selected.join('\n')
          env.HAS_TARGETS = selected ? 'yes' : ''
        }
      }
    }

    // -------------------------------------------------
    // Kill OS processes by PORT
    // -------------------------------------------------
    stage('Kill Processes') {
      when { expression { env.HAS_TARGETS == 'yes' } }
      steps {
        bat '''
          for /f "tokens=1,2 delims=|" %%A in (final_targets.txt) do (
            echo Killing %%A
            for /f "tokens=5" %%P in (
              'netstat -ano ^| findstr LISTENING ^| findstr :%%B'
            ) do taskkill /F /PID %%P >nul 2>&1
          )
        '''
      }
    }

    // -------------------------------------------------
    // Deregister instances from Eureka
    // -------------------------------------------------
    stage('Deregister from Eureka') {
      when { expression { env.HAS_TARGETS == 'yes' } }
      steps {
        bat '''
          for /f "tokens=1,2 delims=|" %%A in (final_targets.txt) do (
            curl -s -X DELETE ^
              http://localhost:%EUREKA_PORT%/eureka/apps/%%A >nul 2>&1
          )
        '''
      }
    }
  }

  post {
    always {
      echo "✅ KillInstances pipeline finished successfully."
    }
  }
}
