pipeline {
  agent any

  parameters {

    booleanParam(name: 'KILL_EUREKA',         defaultValue: false, description: 'Kill Eureka Server')
    booleanParam(name: 'KILL_CONFIGSERVER',   defaultValue: false, description: 'Kill Config Server (8888)')
    booleanParam(name: 'KILL_APIGATEWAY',     defaultValue: false, description: 'Kill API Gateway (9191)')

    booleanParam(name: 'KILL_USERSERVICE',    defaultValue: false, description: 'Kill UserService')
    string(name: 'USERSERVICE_PORTS',         defaultValue: '',    description: 'e.g. 8080,8085')

    booleanParam(name: 'KILL_PRODUCTSERVICE', defaultValue: false, description: 'Kill ProductService')
    string(name: 'PRODUCTSERVICE_PORTS',      defaultValue: '',    description: 'e.g. 8081,8083')

    booleanParam(name: 'KILL_ORDERSERVICE',   defaultValue: false, description: 'Kill OrderService')
    string(name: 'ORDERSERVICE_PORTS',        defaultValue: '',    description: 'e.g. 8082,8084')
  }

  stages {

    stage('Clone Eureka Repo') {
      steps {
        dir('eureka') {
          git url: 'https://github.com/Adrineel-Saha/EurekaServer.git', branch: 'main'
        }
      }
    }

    stage('Read Eureka Port') {
      steps {
        script {
          def yml = readFile('eureka/src/main/resources/application.yml')
          def m = (yml =~ /(?m)^server:\s*(?:\r?\n|\r)\s*port:\s*(\d+)/)
          if (!m.find()) error 'Eureka port not found'
          env.EUREKA_PORT = m.group(1)
          echo "✅ Eureka port = ${env.EUREKA_PORT}"
        }
      }
    }

    stage('Fetch Eureka Registry') {
      steps {
        bat "curl -s http://localhost:${env.EUREKA_PORT}/eureka/apps > apps.xml"
      }
    }

    /* ✅ FIXED: parameter VALUE is passed */
    stage('Kill Selected Microservices') {
      steps {
        bat '''
          @echo on
          call :kill "%KILL_USERSERVICE%" %USERSERVICE_PORTS%
          call :kill "%KILL_PRODUCTSERVICE%" %PRODUCTSERVICE_PORTS%
          call :kill "%KILL_ORDERSERVICE%" %ORDERSERVICE_PORTS%
          exit /b 0

          :kill
          set FLAG=%1
          set PORTS=%2

          if not "%FLAG%"=="true" goto :eof
          if "%PORTS%"=="" goto :eof

          for %%P in (%PORTS:,= %) do (
            echo Killing service on port %%P
            for /f "tokens=5" %%X in (
              'netstat -ano ^| findstr LISTENING ^| findstr :%%P'
            ) do taskkill /F /PID %%X >nul 2>&1
          )
          goto :eof
        '''
      }
    }

    /* ✅ FIXED: Windows‑safe PowerShell */
    stage('Deregister Microservices from Eureka') {
      steps {
        powershell """
          [xml]\$apps = Get-Content 'apps.xml'
          \$ports = @()

          foreach (\$p in '${USERSERVICE_PORTS},${PRODUCTSERVICE_PORTS},${ORDERSERVICE_PORTS}'.Split(',')) {
            if (\$p -ne '') { \$ports += \$p }
          }

          foreach (\$app in \$apps.applications.application) {
            foreach (\$inst in \$app.instance) {
              if (\$ports -contains \$inst.port.'#text') {
                Write-Host "DELETE \$($app.name) / \$($inst.instanceId)"
                curl -s -X DELETE http://localhost:${EUREKA_PORT}/eureka/apps/\$($app.name)/\$($inst.instanceId)
              }
            }
          }
        """
      }
    }

    stage('Kill Infrastructure') {
      steps {
        bat '''
          if "%KILL_CONFIGSERVER%"=="true" (
            for /f "tokens=5" %%P in ('netstat -ano ^| findstr :8888') do taskkill /F /PID %%P >nul
          )
          if "%KILL_APIGATEWAY%"=="true" (
            for /f "tokens=5" %%P in ('netstat -ano ^| findstr :9191') do taskkill /F /PID %%P >nul
          )
          if "%KILL_EUREKA%"=="true" (
            for /f "tokens=5" %%P in ('netstat -ano ^| findstr :%EUREKA_PORT%') do taskkill /F /PID %%P >nul
          )
        '''
      }
    }
  }

  post {
    always {
      echo '✅ KillInstances pipeline finished successfully'
    }
  }
}
