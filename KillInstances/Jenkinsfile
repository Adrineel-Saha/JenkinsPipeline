pipeline {
  agent any

  environment {
    EUREKA_PORT         = ''
    DISCOVERY_ONLY      = 'false'
    HAS_SERVICE_TARGETS = 'false'
    STATE_CHANGED       = 'false'
  }

  stages {

    /* ============================================================
       CLEAN + DISCOVERY
       ============================================================ */

    stage('Clean Workspace') {
      steps { deleteDir() }
    }

    stage('Clone EurekaServer Repo') {
      steps {
        git url: 'https://github.com/Adrineel-Saha/EurekaServer.git', branch: 'main'
      }
    }

    stage('Read Eureka Port') {
      steps {
        script {
          def ymlPath = 'src/main/resources/application.yml'
          if (!fileExists(ymlPath)) {
            error "application.yml not found at ${ymlPath}"
          }
          def yml = readFile ymlPath

          // Match:
          // server:
          //   port: <digits>
          def m = (yml =~ /(?m)^server:\s*(?:\r?\n|\r)\s*port:\s*(\d+)\s*$/)
          if (m.find()) {
            env.EUREKA_PORT = m.group(1)
            echo "Using server.port from application.yml: ${env.EUREKA_PORT}"
          } else {
            error "server.port not found in ${ymlPath}. Please define it under 'server:\\n  port: <number>'."
          }
        }
      }
    }

    stage('Fetch Eureka Registry') {
      steps {
        bat "curl -s http://localhost:%EUREKA_PORT%/eureka/apps > apps.xml"
      }
    }

    /* ============================================================
       CREATE / UPDATE PARAMETERS (DISCOVERY)
       ============================================================ */

    stage('Create / Update Service Checkboxes') {
      steps {
        script {

          writeFile file: 'extract-services.ps1', text: '''
[xml]$x = Get-Content "apps.xml"
$x.applications.application |
ForEach-Object {
  $_.instance | ForEach-Object { $_.app }
} | Sort-Object -Unique | Set-Content "services.txt"
'''
          bat 'powershell -NoProfile -ExecutionPolicy Bypass -File extract-services.ps1'

          def services = []
          if (fileExists('services.txt')) {
            services = readFile('services.txt')
              .readLines()
              .collect { it.trim().toUpperCase() }
              .findAll { it }
          }

          echo "✅ Services registered in Eureka: ${services}"

          def paramsList = []

          /* ✅ KILL_EUREKA always exists */
          paramsList << booleanParam(
            name: 'KILL_EUREKA',
            defaultValue: false,
            description: 'Kill Eureka Server'
          )

          /*
           ✅ KILL_CONFIGSERVER rule preserved:
           - Only appears when it is the ONLY service
          */
          if (services == ['CONFIGSERVER']) {
            paramsList << booleanParam(
              name: 'KILL_CONFIGSERVER',
              defaultValue: false,
              description: 'Kill Config Server'
            )
          }

          /*
           ✅ KILL_{SERVICE} rule preserved:
           - CONFIGSERVER excluded when other services exist
          */
          services.findAll {
            it != 'CONFIGSERVER'
          }.each { svc ->
            paramsList << booleanParam(
              name: "KILL_${svc}",
              defaultValue: false,
              description: "Kill ${svc}"
            )
          }

          properties([
            [$class: 'ParametersDefinitionProperty',
             parameterDefinitions: paramsList]
          ])

          /* ✅ First-time discovery guard */
          if (currentBuild.rawBuild.getAction(hudson.model.ParametersAction) == null) {
            env.DISCOVERY_ONLY = 'true'
          }
        }
      }
    }

    stage('Exit After Discovery') {
      when { expression { env.DISCOVERY_ONLY == 'true' } }
      steps {
        echo '''
✅ DISCOVERY COMPLETE

Parameters have been created/updated.
➡ Please re-run the job and select services to kill.

(No actions executed in this run.)
'''
      }
    }

    /* ============================================================
       ACTION PHASE
       ============================================================ */

    stage('Resolve Selected Instances') {
      when { expression { env.DISCOVERY_ONLY != 'true' } }
      steps {
        script {

          writeFile file: 'resolve-targets.ps1', text: '''
[xml]$x = Get-Content "apps.xml"
$x.applications.application |
ForEach-Object {
  $_.instance | ForEach-Object {
    "$($_.app)|$($_.instanceId)|$($_.port.InnerText)"
  }
} | Set-Content "all_targets.txt"
'''
          bat 'powershell -NoProfile -ExecutionPolicy Bypass -File resolve-targets.ps1'

          def selected = []

          readFile('all_targets.txt').readLines().each { line ->
            def p = line.split('\\|')
            if (p.size() == 3 && params["KILL_${p[0].toUpperCase()}"] == true) {
              selected << line
            }
          }

          writeFile file: 'final_targets.txt', text: selected.join('\n')

          if (selected) {
            env.HAS_SERVICE_TARGETS = 'true'
            echo "✅ Selected targets:\n${selected.join('\n')}"
          }
        }
      }
    }

    stage('Kill Eureka Server') {
      when {
        expression {
          env.DISCOVERY_ONLY != 'true' &&
          params.KILL_EUREKA == true
        }
      }
      steps {
        script { env.STATE_CHANGED = 'true' }
        bat '''
          echo Killing Eureka on port %EUREKA_PORT%
          for /f "tokens=5" %%P in (
            'netstat -ano ^| findstr LISTENING ^| findstr :%EUREKA_PORT%'
          ) do taskkill /F /PID %%P >nul 2>&1
        '''
      }
    }

    stage('Kill Service Processes') {
      when {
        expression {
          env.DISCOVERY_ONLY != 'true' &&
          env.HAS_SERVICE_TARGETS == 'true'
        }
      }
      steps {
        script { env.STATE_CHANGED = 'true' }
        bat '''
          for /f "tokens=1,2,3 delims=|" %%A in (final_targets.txt) do (
            echo Killing %%A on port %%C
            for /f "tokens=5" %%P in (
              'netstat -ano ^| findstr LISTENING ^| findstr :%%C'
            ) do taskkill /F /PID %%P >nul 2>&1
          )
        '''
      }
    }

    stage('Deregister from Eureka') {
      when {
        expression {
          env.DISCOVERY_ONLY != 'true' &&
          env.HAS_SERVICE_TARGETS == 'true' &&
          params.KILL_EUREKA != true
        }
      }
      steps {
        bat '''
          for /f "tokens=1,2 delims=|" %%A in (final_targets.txt) do (
            echo Deregistering %%A
            curl -s -X DELETE ^
              http://localhost:%EUREKA_PORT%/eureka/apps/%%A/%%B >nul 2>&1
          )
        '''
      }
    }

    /* ============================================================
       PARAMETER REFRESH FOR NEXT BUILD
       ============================================================ */

    stage('Refresh Checkboxes For Next Build') {
      when { expression { env.STATE_CHANGED == 'true' } }
      steps {
        echo '''
🔄 State changed.
Service checkboxes have been refreshed
and will reflect Eureka registry in the NEXT build.
'''
      }
    }
  }

  post {
    always {
      echo "✅ KillInstances pipeline completed."
    }
  }
}
