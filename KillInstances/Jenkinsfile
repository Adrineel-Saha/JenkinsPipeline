/* ============================================================
   Groovy-scoped computed values
   ============================================================ */
def EUREKA_PORT = null

pipeline {
  agent any

  environment {
    DISCOVERY_ONLY      = 'true'
    HAS_SERVICE_TARGETS = 'false'
  }

  stages {

    /* ============================================================
       CLEAN + CLONE
       ============================================================ */

    stage('Clean Workspace') {
      steps {
        deleteDir()
      }
    }

    stage('Clone EurekaServer Repo') {
      steps {
        git url: 'https://github.com/Adrineel-Saha/EurekaServer.git', branch: 'main'
      }
    }

    /* ============================================================
       READ EUREKA PORT
       ============================================================ */

    stage('Read Eureka Port') {
      steps {
        script {
          def line = readFile('src/main/resources/application.yml')
            .readLines()
            .find { it.trim().startsWith('port:') }

          if (!line) {
            error "server.port not found in application.yml"
          }

          EUREKA_PORT = line.split(':')[1].trim()
          echo "✅ Eureka Port resolved = ${EUREKA_PORT}"
        }
      }
    }

    /* ============================================================
       FETCH EUREKA REGISTRY
       ============================================================ */

    stage('Fetch Eureka Registry') {
      steps {
        withEnv(["EUREKA_PORT=${EUREKA_PORT}"]) {
          bat 'curl -s http://localhost:%EUREKA_PORT%/eureka/apps > apps.xml'
        }
      }
    }

    /* ============================================================
       EXTRACT REGISTERED SERVICES
       ============================================================ */

    stage('Extract Registered Services') {
      steps {
        writeFile file: 'extract-services.ps1', text: '''
[xml]$x = Get-Content "apps.xml"
$x.applications.application |
ForEach-Object { $_.app } |
Sort-Object -Unique |
Set-Content "services.txt"
'''
        bat 'powershell -NoProfile -ExecutionPolicy Bypass -File extract-services.ps1'

        script {
          if (fileExists('services.txt') && readFile('services.txt').trim()) {
            env.HAS_SERVICE_TARGETS = 'true'
          }
        }
      }
    }

    /* ============================================================
       CREATE / UPDATE KILL CHECKBOXES (ACTIVE CHOICES)
       ============================================================ */

    stage('Create / Update Kill Checkboxes') {
      steps {
        script {
          properties([
            parameters([

              /* ================= KILL_EUREKA ================= */
              [
                $class: 'ChoiceParameter',
                name: 'KILL_EUREKA',
                description: 'Kill Eureka Server',
                choiceType: 'PT_CHECKBOX',
                script: [
                  $class: 'GroovyScript',
                  sandbox: true,
                  script: '''
                    def f = new File("services.txt")
                    if (!f.exists() || f.text.trim().isEmpty()) {
                      return ["KILL_EUREKA"]
                    }
                    return []
                  '''
                ]
              ],

              /* ================= KILL_CONFIGSERVER ================= */
              [
                $class: 'ChoiceParameter',
                name: 'KILL_CONFIGSERVER',
                description: 'Kill Config Server',
                choiceType: 'PT_CHECKBOX',
                script: [
                  $class: 'GroovyScript',
                  sandbox: true,
                  script: '''
                    def f = new File("services.txt")
                    if (f.exists()) {
                      def s = f.readLines()
                      if (s.size() == 1 && s[0] == "CONFIGSERVER") {
                        return ["KILL_CONFIGSERVER"]
                      }
                    }
                    return []
                  '''
                ]
              ],

              /* ================= KILL_SERVICES ================= */
              [
                $class: 'ChoiceParameter',
                name: 'KILL_SERVICES',
                description: 'Kill Registered Services',
                choiceType: 'PT_CHECKBOX',
                script: [
                  $class: 'GroovyScript',
                  sandbox: true,
                  script: '''
                    def f = new File("services.txt")
                    if (f.exists()) {
                      return f.readLines().findAll { it != "CONFIGSERVER" }
                    }
                    return []
                  '''
                ]
              ]
            ])
          ])

          echo "✅ Kill checkboxes updated. Re-run build to apply selections."
        }
      }
    }

    /* ============================================================
       EXIT AFTER DISCOVERY (FIRST BUILD)
       ============================================================ */

    stage('Exit After Discovery') {
      when { expression { env.DISCOVERY_ONLY == 'true' } }
      steps {
        echo '''
✅ DISCOVERY RUN COMPLETE
No kill or deregister executed.
Re-run the job to enable kill actions.
'''
      }
    }

    /* ============================================================
       KILL EUREKA SERVER
       ============================================================ */

    stage('Kill Eureka Server') {
      when {
        expression {
          params.KILL_EUREKA?.contains('KILL_EUREKA')
        }
      }
      steps {
        withEnv(["EUREKA_PORT=${EUREKA_PORT}"]) {
          bat '''
            echo Killing Eureka on port %EUREKA_PORT%
            for /f "tokens=5" %%P in (
              'netstat -ano ^| findstr LISTENING ^| findstr :%EUREKA_PORT%'
            ) do taskkill /F /PID %%P >nul 2>&1
          '''
        }
      }
    }

    /* ============================================================
       KILL SERVICE PROCESSES
       ============================================================ */

    stage('Kill Service Processes') {
      when {
        expression {
          params.KILL_SERVICES != null && params.KILL_SERVICES.size() > 0
        }
      }
      steps {
        bat '''
          for %%S in (%KILL_SERVICES%) do (
            echo Killing service %%S
          )
        '''
      }
    }

    /* ============================================================
       DEREGISTER FROM EUREKA
       ============================================================ */

    stage('Deregister from Eureka') {
      when {
        expression {
          params.KILL_SERVICES != null && params.KILL_SERVICES.size() > 0
        }
      }
      steps {
        withEnv(["EUREKA_PORT=${EUREKA_PORT}"]) {
          bat '''
            for %%S in (%KILL_SERVICES%) do (
              curl -s -X DELETE ^
                http://localhost:%EUREKA_PORT%/eureka/apps/%%S >nul 2>&1
            )
          '''
        }
      }
    }

    /* ============================================================
       REFRESH CHECKBOXES (NEXT BUILD)
       ============================================================ */

    stage('Refresh Kill Checkboxes') {
      steps {
        echo "✅ Registry state updated. Checkboxes will reflect changes in the next build."
      }
    }
  }

  /* ============================================================
     POST ACTIONS (REQUIRED)
     ============================================================ */

  post {
    always {
      echo "✅ Kill-Instances pipeline finished."
    }

    success {
      echo "✅ Pipeline executed successfully."
    }

    failure {
      echo "❌ Pipeline failed. Please review the logs above."
    }
  }
}
