pipeline {
  agent any

  stages {

    stage('Clean Workspace') {
      steps {
        deleteDir()
      }
    }

    // -------------------------------------------------
    // Clone ONLY EurekaServer
    // -------------------------------------------------
    stage('Clone EurekaServer Repo') {
      steps {
        dir('eureka') {
          git url: 'https://github.com/Adrineel-Saha/EurekaServer.git', branch: 'main'
        }
      }
    }

    // -------------------------------------------------
    // Read Eureka server.port from application.yml
    // -------------------------------------------------
    stage('Read Eureka Port from application.yml') {
      steps {
        script {
          def yml = readFile('eureka/src/main/resources/application.yml')

          // ✅ ORIGINAL, APPROVED REGEX — UNCHANGED
          def m = (yml =~ /(?m)^server:\s*(?:\r?\n|\r)\s*port:\s*(\d+)\s*$/)

          if (!m.find()) {
            error "server.port not found in Eureka application.yml"
          }

          env.EUREKA_PORT = m.group(1)
          echo "Eureka port resolved."
        }
      }
    }

    // -------------------------------------------------
    // Fetch Eureka registry (XML)
    // -------------------------------------------------
    stage('Fetch Eureka Registry (XML)') {
      steps {
        bat '''
          curl -s http://localhost:%EUREKA_PORT%/eureka/apps > apps.xml
        '''
      }
    }

    // -------------------------------------------------
    // ✅ Create checkboxes using SHOW / HIDE logic
    // -------------------------------------------------
    stage('Create Service Checkboxes') {
      steps {
        script {

          // ✅ PowerShell script: extract service names
          writeFile file: 'extract-services.ps1', text: '''
[xml]$x = Get-Content "apps.xml"

$x.applications.application | ForEach-Object {
    $_.name
} | Set-Content "services.txt"
'''

          bat 'powershell -NoProfile -ExecutionPolicy Bypass -File extract-services.ps1'

          def services = readFile('services.txt')
            .readLines()
            .collect { it.trim().toUpperCase() }
            .findAll { it }
            .unique()

          echo "Services currently in Eureka: ${services}"

          def paramsList = []

          // SHOW KILL_EUREKA only if NO services exist
          if (services.isEmpty()) {
            paramsList << booleanParam(
              name: 'KILL_EUREKA',
              defaultValue: false,
              description: 'Kill Eureka Server'
            )
          }

          // SHOW KILL_CONFIGSERVER only if it is the ONLY service
          if (services == ['CONFIGSERVER']) {
            paramsList << booleanParam(
              name: 'KILL_CONFIGSERVER',
              defaultValue: false,
              description: 'Kill Config Server'
            )
          }

          // SHOW other services always (except CONFIGSERVER)
          services.findAll { it != 'CONFIGSERVER' }.each { svc ->
            paramsList << booleanParam(
              name: "KILL_${svc}",
              defaultValue: false,
              description: "Kill ${svc}"
            )
          }

          // Reset and apply parameters for NEXT build
          properties([])
          properties([parameters(paramsList)])

          echo "✅ Checkboxes created using SHOW/HIDE logic. Re-run with 'Build with Parameters'."
          currentBuild.result = 'SUCCESS'
          return
        }
      }
    }

    // -------------------------------------------------
    // Resolve ports for selected services
    // -------------------------------------------------
    stage('Resolve Selected Instances') {
      steps {
        script {

          // ✅ FIXED PowerShell script: extract PORT TEXT, not XML element
          writeFile file: 'resolve-targets.ps1', text: '''
[xml]$x = Get-Content "apps.xml"

$x.applications.application | ForEach-Object {
    $app = $_.name
    $_.instance | ForEach-Object {
