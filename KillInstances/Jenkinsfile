def EUREKA_PORT = null

pipeline {
  agent any

  stages {

    /* ============================================================
       CLONE EUREKA SERVER REPO
       ============================================================ */
    stage('Clone EurekaServer Repo') {
      steps {
        git url: 'https://github.com/Adrineel-Saha/EurekaServer.git', branch: 'main'
      }
    }

    /* ============================================================
       READ EUREKA PORT
       ============================================================ */
    stage('Read Eureka Port') {
      steps {
        script {
          def line = readFile('src/main/resources/application.yml')
            .readLines()
            .find { it.trim().startsWith('port:') }

          if (!line) {
            error 'server.port not found in application.yml'
          }

          EUREKA_PORT = line.split(':')[1].trim()
          echo "✅ Eureka Port = ${EUREKA_PORT}"
        }
      }
    }

    /* ============================================================
       FETCH EUREKA REGISTRY
       ============================================================ */
    stage('Fetch Eureka Registry') {
      steps {
        withEnv(["EUREKA_PORT=${EUREKA_PORT}"]) {
          bat 'curl -s http://localhost:%EUREKA_PORT%/eureka/apps > apps.xml'
        }
      }
    }

    /* ============================================================
       EXTRACT REGISTERED SERVICES
       ============================================================ */
    stage('Extract Registered Services') {
      steps {
        writeFile file: 'extract-services.ps1', text: '''
[xml]$x = Get-Content "apps.xml"
$x.applications.application |
ForEach-Object { $_.app } |
Sort-Object -Unique |
Set-Content "services.txt"
'''
        bat 'powershell -NoProfile -ExecutionPolicy Bypass -File extract-services.ps1'

        script {
          echo "✅ Services from Eureka:"
          if (fileExists('services.txt')) {
            echo readFile('services.txt')
          } else {
            echo "(none)"
          }
        }
      }
    }

    /* ============================================================
       RESOLVE SELECTED TARGET
       ============================================================ */
    stage('Resolve Selected Target') {
      steps {
        script {
          echo "KILL_EUREKA       = ${params.KILL_EUREKA}"
          echo "KILL_CONFIGSERVER = ${params.KILL_CONFIGSERVER}"

          if (params.KILL_EUREKA?.contains('KILL_EUREKA')) {
            echo "➡ Target resolved: EUREKA"
          } else if (params.KILL_CONFIGSERVER?.contains('KILL_CONFIGSERVER')) {
            echo "➡ Target resolved: CONFIGSERVER"
          } else {
            echo "➡ No kill target selected"
          }
        }
      }
    }

    /* ============================================================
       KILL PROCESS
       ============================================================ */
    stage('Kill Process') {
      when {
        expression {
          params.KILL_EUREKA?.contains('KILL_EUREKA') ||
          params.KILL_CONFIGSERVER?.contains('KILL_CONFIGSERVER')
        }
      }
      steps {
        script {
          if (params.KILL_EUREKA?.contains('KILL_EUREKA')) {
            withEnv(["EUREKA_PORT=${EUREKA_PORT}"]) {
              bat '''
                echo Killing Eureka on port %EUREKA_PORT%
                for /f "tokens=5" %%P in (
                  'netstat -ano ^| findstr LISTENING ^| findstr :%EUREKA_PORT%'
                ) do taskkill /F /PID %%P >nul 2>&1
              '''
            }
          }

          if (params.KILL_CONFIGSERVER?.contains('KILL_CONFIGSERVER')) {
            echo "✅ Config Server kill logic goes here"
          }
        }
      }
    }

    /* ============================================================
       DEREGISTER FROM EUREKA
       ============================================================ */
    stage('Deregister') {
      when {
        expression {
          params.KILL_CONFIGSERVER?.contains('KILL_CONFIGSERVER')
        }
      }
      steps {
        withEnv(["EUREKA_PORT=${EUREKA_PORT}"]) {
          bat '''
            echo Deregistering CONFIGSERVER from Eureka
            curl -s -X DELETE ^
              http://localhost:%EUREKA_PORT%/eureka/apps/CONFIGSERVER >nul 2>&1
          '''
        }
      }
    }

    /* ============================================================
       UPDATE CHECKBOXES (ACTIVE CHOICES)
       ============================================================ */
    stage('Update Kill Checkboxes') {
      steps {
        script {
          properties([
            parameters([

              /* ================= KILL_EUREKA ================= */
              [
                $class: 'ChoiceParameter',
                name: 'KILL_EUREKA',
                description: 'Kill Eureka Server (enabled only when no services)',
                choiceType: 'PT_CHECKBOX',
                script: [
                  $class: 'GroovyScript',
                  script: '''
                    def f = new File("services.txt")
                    if (!f.exists() || f.text.trim().isEmpty()) {
                      return ["KILL_EUREKA"]
                    }
                    return []
                  ''',
                  fallbackScript: 'return []'
                ]
              ],

              /* ================= KILL_CONFIGSERVER ================= */
              [
                $class: 'ChoiceParameter',
                name: 'KILL_CONFIGSERVER',
                description: 'Kill Config Server (enabled only when alone)',
                choiceType: 'PT_CHECKBOX',
                script: [
                  $class: 'GroovyScript',
                  script: '''
                    def f = new File("services.txt")
                    if (f.exists()) {
                      def lines = f.readLines()
                      if (lines.size() == 1 && lines[0] == "CONFIGSERVER") {
                        return ["KILL_CONFIGSERVER"]
                      }
                    }
                    return []
                  ''',
                  fallbackScript: 'return []'
                ]
              ]
            ])
          ])

          echo "✅ Kill checkboxes updated for NEXT build"
        }
      }
    }
  }

  /* ============================================================
     POST
     ============================================================ */
  post {
    always {
      echo "✅ KillInstances pipeline finished"
    }
    success {
      echo "✅ Pipeline completed successfully"
    }
    failure {
      echo "❌ Pipeline failed – check logs"
    }
  }
}
