pipeline {
  agent any

  stages {

    stage('Clean Workspace') {
      steps { deleteDir() }
    }

    stage('Clone EurekaServer Repo') {
      steps {
        dir('eureka') {
          git url: 'https://github.com/Adrineel-Saha/EurekaServer.git', branch: 'main'
        }
      }
    }

    stage('Read Eureka Port from application.yml') {
      steps {
        script {
          def yml = readFile('eureka/src/main/resources/application.yml')

          // ✅ ORIGINAL REGEX (UNCHANGED)
          def m = (yml =~ /(?m)^server:\s*(?:\r?\n|\r)\s*port:\s*(\d+)\s*$/)
          if (!m.find()) error "server.port not found"

          env.EUREKA_PORT = m.group(1)
          echo "Eureka port resolved."
        }
      }
    }

    stage('Fetch Eureka Registry (XML)') {
      steps {
        bat 'curl -s http://localhost:%EUREKA_PORT%/eureka/apps > apps.xml'
      }
    }

    stage('Resolve Selected Instances') {
      steps {
        script {

          writeFile file: 'resolve-targets.ps1', text: '''
[xml]$x = Get-Content "apps.xml"

$x.applications.application |
ForEach-Object {
    $_.instance | ForEach-Object {
        "$($_.app)|$($_.instanceId)|$($_.port.InnerText)"
    }
} | Set-Content "all_targets.txt"
'''
          bat 'powershell -NoProfile -ExecutionPolicy Bypass -File resolve-targets.ps1'

          def selected = []

          if (params) {
            readFile('all_targets.txt').readLines().each { line ->
              def parts = line.split('\\|')
              if (parts.size() == 3) {
                def app = parts[0].toUpperCase()
                if (params["KILL_${app}"]) {
                  selected << line
                }
              }
            }
          }

          writeFile file: 'final_targets.txt', text: selected.join('\n')
          env.HAS_TARGETS = selected ? 'yes' : ''
        }
      }
    }

    stage('Kill Processes') {
      when { expression { env.HAS_TARGETS == 'yes' } }
      steps {
        bat '''
          @echo off
          for /f "tokens=1,2,3 delims=|" %%A in (final_targets.txt) do (
            for /f "tokens=5" %%P in (
              'netstat -ano ^| findstr LISTENING ^| findstr :%%C'
            ) do taskkill /F /PID %%P >nul 2>&1 || echo PID %%P already stopped
          )
          exit /b 0
        '''
      }
    }

    stage('Deregister from Eureka') {
      when { expression { env.HAS_TARGETS == 'yes' } }
      steps {
        bat '''
          for /f "tokens=1,2,3 delims=|" %%A in (final_targets.txt) do (
            curl -s -X DELETE ^
              http://localhost:%EUREKA_PORT%/eureka/apps/%%A/%%B >nul 2>&1
          )
        '''
      }
    }

    stage('Wait for Eureka Registry Refresh') {
      steps {
        script {
          int maxRetries = 12
          int sleepSeconds = 5

          for (int i = 1; i <= maxRetries; i++) {
            echo "Polling Eureka registry (attempt ${i}/${maxRetries})"

            bat 'curl -s http://localhost:%EUREKA_PORT%/eureka/apps > apps.xml'

            writeFile file: 'extract-instance-ids.ps1', text: '''
[xml]$x = Get-Content "apps.xml"
$x.applications.application |
ForEach-Object {
    $_.instance | ForEach-Object { $_.instanceId }
} | Set-Content "instance_ids.txt"
'''
            bat 'powershell -NoProfile -ExecutionPolicy Bypass -File extract-instance-ids.ps1'

            def ids = readFile('instance_ids.txt').readLines().findAll { it }

            echo "Instance IDs still present: ${ids}"

            if (ids.isEmpty()) {
              echo "Eureka registry stabilized."
              break
            }

            sleep sleepSeconds
          }
        }
      }
    }

    stage('Create Service Checkboxes') {
      steps {
        script {

          // ✅ ALWAYS regenerate services.txt here
          writeFile file: 'extract-services.ps1', text: '''
[xml]$x = Get-Content "apps.xml"
$x.applications.application |
ForEach-Object {
    $_.instance | ForEach-Object { $_.app }
} | Sort-Object -Unique | Set-Content "services.txt"
'''
          bat 'powershell -NoProfile -ExecutionPolicy Bypass -File extract-services.ps1'

          def services = []
          if (fileExists('services.txt')) {
            services = readFile('services.txt')
              .readLines()
              .collect { it.trim().toUpperCase() }
              .findAll { it }
          }

          echo "FINAL active services: ${services}"

          // ✅ If Eureka was killed → clear all parameters
          if (params?.KILL_EUREKA) {
            echo "Eureka Server killed. Clearing parameters."
            properties([])
            currentBuild.result = 'SUCCESS'
            return
          }

          def paramsList = []

          if (services.isEmpty()) {
            paramsList << booleanParam(
              name: 'KILL_EUREKA',
              defaultValue: false,
              description: 'Kill Eureka Server'
            )
          }

          if (services == ['CONFIGSERVER']) {
            paramsList << booleanParam(
              name: 'KILL_CONFIGSERVER',
              defaultValue: false,
              description: 'Kill Config Server'
            )
          }

          services.findAll { it != 'CONFIGSERVER' }.each { svc ->
            paramsList << booleanParam(
              name: "KILL_${svc}",
              defaultValue: false,
              description: "Kill ${svc}"
            )
          }

          properties([
            [$class: 'ParametersDefinitionProperty',
             parameterDefinitions: paramsList]
          ])

          currentBuild.result = 'SUCCESS'
          return
        }
      }
    }
  }

  post {
    always {
      echo "✅ KillInstances finished successfully."
    }
  }
}
