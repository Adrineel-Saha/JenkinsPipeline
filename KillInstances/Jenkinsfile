pipeline {
  agent any

  environment {
    HAS_PARAMS  = ''
    HAS_TARGETS = ''
  }

  stages {

    /* ============================================================
       CLEAN WORKSPACE
       ============================================================ */
    stage('Clean Workspace') {
      steps { deleteDir() }
    }

    /* ============================================================
       CLONE EUREKA SERVER REPO
       ============================================================ */
    stage('Clone EurekaServer Repo') {
      steps {
        dir('eureka') {
          git url: 'https://github.com/Adrineel-Saha/EurekaServer.git', branch: 'main'
        }
      }
    }

    /* ============================================================
       READ EUREKA PORT
       ============================================================ */
    stage('Read Eureka Port') {
      steps {
        script {
          def yml = readFile('eureka/src/main/resources/application.yml')
          def m = (yml =~ /(?m)^server:\s*(?:\r?\n|\r)\s*port:\s*(\d+)\s*$/)
          if (!m.find()) error "server.port not found"
          env.EUREKA_PORT = m.group(1)
          echo "✅ Eureka port = ${env.EUREKA_PORT}"
        }
      }
    }

    /* ============================================================
       FETCH EUREKA REGISTRY
       ============================================================ */
    stage('Fetch Eureka Registry') {
      steps {
        bat 'curl -s http://localhost:%EUREKA_PORT%/eureka/apps > apps.xml'
      }
    }

    /* ============================================================
       DISCOVERY PHASE (FIRST BUILD)
       ============================================================ */
    stage('Discovery Phase') {
      steps {
        script {
          if (!params || params.isEmpty()) {
            echo '''
✅ DISCOVERY BUILD

- Registry fetched
- Services analyzed
- Checkboxes will be generated
➡ Re-run job using "Build with Parameters"
'''
          }
        }
      }
    }

    /* ============================================================
       EXECUTION PHASE (SECOND BUILD)
       ============================================================ */
    stage('Resolve Selected Instances') {
      when { expression { params && !params.isEmpty() } }
      steps {
        script {
          writeFile file: 'resolve.ps1', text: '''
[xml]$x = Get-Content "apps.xml"
$x.applications.application |
ForEach-Object {
  $_.instance | Where-Object { $_.status -eq 'UP' } |
  ForEach-Object {
    "$($_.app)|$($_.instanceId)|$($_.port.InnerText)"
  }
} | Set-Content "targets.txt"
'''
          bat 'powershell -NoProfile -ExecutionPolicy Bypass -File resolve.ps1'
        }
      }
    }

    /* ============================================================
       CREATE CHECKBOXES (LAST STAGE)
       ============================================================ */
    stage('Create Service Checkboxes') {
      steps {
        script {

          writeFile file: 'extract.ps1', text: '''
[xml]$x = Get-Content "apps.xml"
$x.applications.application |
ForEach-Object {
  if ($_.instance) { $_.app }
} | Sort-Object -Unique | Set-Content "services.txt"
'''
          bat 'powershell -NoProfile -ExecutionPolicy Bypass -File extract.ps1'

          def services = readFile('services.txt')
            .readLines()
            .collect { it.trim().toUpperCase() }
            .findAll { it }

          def paramsList = []

          if (services.isEmpty()) {
            paramsList << booleanParam('KILL_EUREKA', false, 'Kill Eureka Server')
          }

          if (services == ['CONFIGSERVER']) {
            paramsList << booleanParam('KILL_CONFIGSERVER', false, 'Kill Config Server')
          }

          services.findAll { it != 'CONFIGSERVER' }.each {
            paramsList << booleanParam("KILL_${it}", false, "Kill ${it}")
          }

          properties([
            [$class: 'ParametersDefinitionProperty',
             parameterDefinitions: paramsList]
          ])

          echo "✅ Parameters ready for NEXT build."
        }
      }
    }
  }

  post {
    always {
      echo "✅ KillInstances pipeline completed."
    }
  }
}
