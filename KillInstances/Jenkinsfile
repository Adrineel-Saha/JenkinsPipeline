pipeline {
  agent any

  stages {

    stage('Clean Workspace') {
      steps {
        deleteDir()
      }
    }

    stage('Clone EurekaServer Repo') {
      steps {
        dir('eureka') {
          git url: 'https://github.com/Adrineel-Saha/EurekaServer.git',
              branch: 'main'
        }
      }
    }

    stage('Read Eureka Port from application.yml') {
      steps {
        script {
          def yml = readFile('eureka/src/main/resources/application.yml')
          def m = (yml =~ /(?m)^server:\s*(?:\r?\n|\r)\s*port:\s*(\d+)\s*$/)
          if (!m.find()) {
            error 'server.port not found in application.yml'
          }
          env.EUREKA_PORT = m.group(1)
          echo "✅ Eureka port resolved: ${env.EUREKA_PORT}"
        }
      }
    }

    stage('Fetch Eureka Registry (XML)') {
      steps {
        bat '''
          curl -s http://localhost:%EUREKA_PORT%/eureka/apps > apps.xml
          exit /b 0
        '''
      }
    }

    stage('Resolve UP Instances Only') {
      steps {
        script {

          writeFile file: 'resolve-targets.ps1', text: '''
[xml]$x = Get-Content "apps.xml"

$x.applications.application |
ForEach-Object {
    $_.instance | Where-Object { $_.status -eq 'UP' } |
    ForEach-Object {
        "$($_.app)|$($_.instanceId)|$($_.port.InnerText)"
    }
} | Set-Content "all_targets.txt"
'''
          bat 'powershell -NoProfile -ExecutionPolicy Bypass -File resolve-targets.ps1'

          def selected = []

          if (fileExists('all_targets.txt')) {
            readFile('all_targets.txt').readLines().each { line ->
              def parts = line.split('\\|')
              if (parts.size() == 3) {
                def app = parts[0].toUpperCase()
                if (params["KILL_${app}"]) {
                  selected << line
                }
              }
            }
          }

          writeFile file: 'final_targets.txt', text: selected.join('\n')
          env.HAS_TARGETS = selected ? 'yes' : ''
        }
      }
    }

    stage('Kill Processes') {
      when { expression { env.HAS_TARGETS == 'yes' } }
      steps {
        bat '''
          @echo off
          for /f "tokens=1,2,3 delims=|" %%A in (final_targets.txt) do (
            for /f "tokens=5" %%P in (
              'netstat -ano ^| findstr LISTENING ^| findstr :%%C'
            ) do (
              taskkill /F /PID %%P >nul 2>&1 || echo PID %%P already stopped
            )
          )
          exit /b 0
        '''
      }
    }

    stage('Deregister from Eureka') {
      when { expression { env.HAS_TARGETS == 'yes' } }
      steps {
        bat '''
          for /f "tokens=1,2,3 delims=|" %%A in (final_targets.txt) do (
            curl -s -X DELETE ^
              http://localhost:%EUREKA_PORT%/eureka/apps/%%A/%%B >nul 2>&1
          )
          exit /b 0
        '''
      }
    }

    stage('Wait for Eureka Registry Refresh') {
      steps {
        script {
          int retries = 6
          int waitSec = 5

          for (int i = 1; i <= retries; i++) {
            echo "Polling Eureka registry (attempt ${i}/${retries})"

            bat '''
              curl -s http://localhost:%EUREKA_PORT%/eureka/apps > apps.xml
              exit /b 0
            '''

            writeFile file: 'extract-services.ps1', text: '''
[xml]$x = Get-Content "apps.xml"
$services = @()

$x.applications.application |
ForEach-Object {
    if ($_.instance | Where-Object { $_.status -eq 'UP' }) {
        $services += $_.name
    }
}

$services | Set-Content "services.txt"
'''
            bat 'powershell -NoProfile -ExecutionPolicy Bypass -File extract-services.ps1'

            def services = fileExists('services.txt')
              ? readFile('services.txt').readLines().findAll { it.trim() }
              : []

            if (services.isEmpty()) {
              writeFile file: 'services.txt', text: ''
              echo '✅ Eureka registry is EMPTY'
              break
            }

            echo "Services still present: ${services}"
            sleep waitSec
          }
        }
      }
    }

    stage('Create Service Checkboxes') {
      steps {
        script {

          def services = fileExists('services.txt')
            ? readFile('services.txt')
                .readLines()
                .collect { it.trim().toUpperCase() }
                .findAll { it }
                .unique()
            : []

          echo "FINAL services: ${services}"

          def paramsList = []

          // ✅ REQUIRED BEHAVIOR
          if (services.isEmpty()) {
            paramsList << booleanParam(
              name: 'KILL_EUREKA',
              defaultValue: false,
              description: 'Kill Eureka Server'
            )
          } else {
            services.each { svc ->
              paramsList << booleanParam(
                name: "KILL_${svc}",
                defaultValue: false,
                description: "Kill ${svc}"
              )
            }
          }

          properties([
            [$class: 'ParametersDefinitionProperty',
             parameterDefinitions: paramsList]
          ])

          echo "✅ Jenkins parameters refreshed"
        }
      }
    }
  }

  post {
    always {
      echo "✅ KillInstances pipeline finished"
    }
  }
}
