pipeline {
  agent any

  parameters {

    booleanParam(name: 'KILL_EUREKA', defaultValue: false, description: 'Kill Eureka Server')
    booleanParam(name: 'KILL_APIGATEWAY', defaultValue: false, description: 'Kill API Gateway')
    booleanParam(name: 'KILL_CONFIGSERVER', defaultValue: false, description: 'Kill Config Server')

    booleanParam(name: 'KILL_USERSERVICE', defaultValue: false, description: 'Kill User Service')
    string(name: 'USERSERVICE_PORTS', defaultValue: '', description: 'UserService ports (comma-separated). Empty = ALL')

    booleanParam(name: 'KILL_PRODUCTSERVICE', defaultValue: false, description: 'Kill Product Service')
    string(name: 'PRODUCTSERVICE_PORTS', defaultValue: '', description: 'ProductService ports (comma-separated). Empty = ALL')

    booleanParam(name: 'KILL_ORDERSERVICE', defaultValue: false, description: 'Kill Order Service')
    string(name: 'ORDERSERVICE_PORTS', defaultValue: '', description: 'OrderService ports (comma-separated). Empty = ALL')
  }

  stages {

    stage('Clean Workspace') {
      steps { deleteDir() }
    }

    stage('Clone EurekaServer Repo') {
      steps {
        dir('eureka') {
          git url: 'https://github.com/Adrineel-Saha/EurekaServer.git', branch: 'main'
        }
      }
    }

    stage('Read Eureka Port from application.yml') {
      steps {
        script {
          def yml = readFile('eureka/src/main/resources/application.yml')
          def m = (yml =~ /(?m)^server:\s*(?:\r?\n|\r)\s*port:\s*(\d+)/)
          if (!m.find()) error 'server.port not found'
          env.EUREKA_PORT = m.group(1)
          echo "✅ Eureka port = ${env.EUREKA_PORT}"
        }
      }
    }

    stage('Fetch Eureka Registry (XML)') {
      steps {
        bat 'curl -s http://localhost:%EUREKA_PORT%/eureka/apps > apps.xml'
      }
    }

    stage('Resolve Targets from Eureka Registry') {
      steps {
        script {

          def portMap = [
            USERSERVICE    : params.USERSERVICE_PORTS,
            PRODUCTSERVICE : params.PRODUCTSERVICE_PORTS,
            ORDERSERVICE   : params.ORDERSERVICE_PORTS
          ]

          writeFile file: 'resolve.ps1', text: '''
[xml]$x = Get-Content "apps.xml"
$targets = @()

foreach ($app in $x.applications.application) {
  foreach ($inst in $app.instance) {
    if ($inst.status -eq "UP") {
      $targets += "$($app.name)|$($inst.instanceId)|$($inst.port.'#text')"
    }
  }
}

$targets | Set-Content "targets.txt"
'''
          bat 'powershell -NoProfile -ExecutionPolicy Bypass -File resolve.ps1'

          def finalTargets = []

          readFile('targets.txt').readLines().each { line ->
            def (app, id, port) = line.split('\\|')

            def killEnabled =
              (app == 'USERSERVICE'      && params.KILL_USERSERVICE) ||
              (app == 'PRODUCTSERVICE'   && params.KILL_PRODUCTSERVICE) ||
              (app == 'ORDERSERVICE'     && params.KILL_ORDERSERVICE) ||
              (app == 'APIGATEWAY'       && params.KILL_APIGATEWAY) ||
              (app == 'CONFIGSERVER'     && params.KILL_CONFIGSERVER)

            if (!killEnabled) return

            /* Non‑port services */
            if (!portMap.containsKey(app)) {
              finalTargets << line
              return
            }

            /* CPS‑SAFE port handling */
            def selectedPorts = []
            if (portMap[app]?.trim()) {
              selectedPorts = portMap[app]
                .split(',')
                .collect { it.trim() }
                .findAll { it.isInteger() }
            }

            if (!selectedPorts || selectedPorts.isEmpty()) {
              finalTargets << line
            } else if (selectedPorts.contains(port)) {
              finalTargets << line
            }
          }

          writeFile file: 'final_targets.txt', text: finalTargets.join('\n')
          env.HAS_APP_TARGETS = finalTargets ? 'yes' : ''

          echo '✅ Final targets:'
          finalTargets.each { echo it }
        }
      }
    }

    stage('Kill Application Processes') {
      when { expression { env.HAS_APP_TARGETS == 'yes' } }
      steps {
        bat '''
          for /f "tokens=1,2,3 delims=|" %%A in (final_targets.txt) do (
            for /f "tokens=5" %%P in (
              'netstat -ano ^| findstr LISTENING ^| findstr :%%C'
            ) do (
              taskkill /F /PID %%P >nul 2>&1
            )
          )
          exit /b 0
        '''
      }
    }

    stage('Deregister Applications from Eureka') {
      when { expression { env.HAS_APP_TARGETS == 'yes' } }
      steps {
        bat '''
          for /f "tokens=1,2,3 delims=|" %%A in (final_targets.txt) do (
            curl -s -X DELETE http://localhost:%EUREKA_PORT%/eureka/apps/%%A/%%B >nul
          )
          exit /b 0
        '''
      }
    }

    stage('Kill Eureka Server') {
      when { expression { params.KILL_EUREKA } }
      steps {
        bat '''
          for /f "tokens=5" %%P in (
            'netstat -ano ^| findstr LISTENING ^| findstr :%EUREKA_PORT%'
          ) do taskkill /F /PID %%P >nul
          exit /b 0
        '''
      }
    }
  }

  post {
    always {
      echo '✅ KillInstances pipeline completed successfully'
    }
  }
}
