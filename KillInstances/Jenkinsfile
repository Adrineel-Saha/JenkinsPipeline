pipeline {
  agent any

  stages {

    stage('Clean Workspace') {
      steps {
        deleteDir()
      }
    }

    // -------------------------------------------------
    // Clone ONLY EurekaServer
    // -------------------------------------------------
    stage('Clone EurekaServer Repo') {
      steps {
        dir('eureka') {
          git url: 'https://github.com/Adrineel-Saha/EurekaServer.git', branch: 'main'
        }
      }
    }

    // -------------------------------------------------
    // Read Eureka server.port from application.yml
    // -------------------------------------------------
    stage('Read Eureka Port from application.yml') {
      steps {
        script {
          def yml = readFile('eureka/src/main/resources/application.yml')
          def m = (yml =~ /(?m)^server:\s*(?:\r?\n|\r)\s*port:\s*(\d+)\s*$/)
          if (!m.find()) {
            error "server.port not found in Eureka application.yml"
          }
          env.EUREKA_PORT = m.group(1)
          echo "Eureka port from repo: ${env.EUREKA_PORT}"
        }
      }
    }

    // -------------------------------------------------
    // Fetch Eureka registry (JSON forced)
    // -------------------------------------------------
    stage('Fetch Eureka Registry') {
      steps {
        bat '''
          @echo on
          curl -s -H "Accept: application/json" ^
            http://localhost:%EUREKA_PORT%/eureka/apps > apps.json
        '''
      }
    }

    // -------------------------------------------------
    // Create checkboxes for ALL services
    // -------------------------------------------------
    stage('Create Service Checkboxes') {
      steps {
        script {
          def apps = new groovy.json.JsonSlurper()
            .parseText(readFile('apps.json'))
            ?.applications?.application

          if (apps instanceof Map) apps = [apps]

          def paramsList = []
          apps.each { app ->
            def name = app.name.toString().toUpperCase()
