pipeline {
  agent any

  parameters {
    booleanParam(name: 'BOOTSTRAP', defaultValue: false, description: 'Initial run')
  }

  stages {

    stage('Clean Workspace') {
      steps { deleteDir() }
    }

    stage('Clone Eureka Repo') {
      steps {
        git url: 'https://github.com/Adrineel-Saha/EurekaServer.git', branch: 'main'
      }
    }

    stage('Read Eureka Port') {
      steps {
        script {
          def yml = readFile 'src/main/resources/application.yml'
          def m = (yml =~ /(?m)^server:\s*(?:\r?\n)\s*port:\s*(\d+)/)
          if (!m.find()) error 'Eureka port missing'
          env.EUREKA_PORT = m.group(1)
          echo "Eureka Port = ${env.EUREKA_PORT}"
        }
      }
    }

    stage('Create Checkboxes From Eureka XML') {
      steps {
        bat 'curl -s -H "Accept: application/xml" http://127.0.0.1:%EUREKA_PORT%/eureka/apps -o apps.xml'

        bat '''
        powershell -Command ^
        "$xml=Get-Content apps.xml; ^
         $apps=$xml.applications.application; ^
         $apps.name | ForEach-Object { ^
           'SVC_'+($_ -replace '[^A-Za-z0-9]','_').ToUpper()+'='+$_.ToLower() ^
         } | Sort-Object -Unique" > svc_map.txt
        '''

        script {
          def paramsList=[]
          readFile('svc_map.txt').readLines().each {
            def (p, svc) = it.split('=')
            paramsList << [
              $class: 'BooleanParameterDefinition',
              name: p,
              defaultValue: false,
              description: "Kill service: ${svc}"
            ]
          }
          properties([parameters(paramsList)])
        }
      }
    }

    stage('Resolve Ports From Eureka XML') {
      steps {
        bat '''
        powershell -Command ^
        "$xml=Get-Content apps.xml; ^
         $ports=@(); ^
         foreach($l in Get-Content svc_map.txt){ ^
           $p,$svc=$l -split '='; ^
           if($env:$p -eq 'true'){ ^
             $xml.applications.application | Where-Object { $_.name.ToLower() -eq $svc } | ForEach-Object { ^
               $_.instance | ForEach-Object { $ports += $_.port } ^
             } ^
           } ^
         }; ^
         $ports | Sort-Object -Unique" > ports.txt
        '''

        script {
          env.PORTS_TO_KILL = readFile('ports.txt').trim()
          echo "Ports to kill: ${env.PORTS_TO_KILL}"
        }
      }
    }

    stage('Kill Instances') {
      when { expression { env.PORTS_TO_KILL } }
      steps {
        bat '''
        for %%P in (%PORTS_TO_KILL%) do (
          for /f "tokens=5" %%X in ('netstat -ano ^| findstr :%%P') do (
            taskkill /F /PID %%X >nul 2>&1
          )
        )
        '''
      }
    }

    stage('Deregister From Eureka') {
      when { expression { env.PORTS_TO_KILL } }
      steps {
        bat '''
        powershell -Command ^
        "$xml=Get-Content apps.xml; ^
         foreach($a in $xml.applications.application){ ^
           foreach($i in $a.instance){ ^
             if('%PORTS_TO_KILL%'.Split(' ') -contains $i.port){ ^
               curl -s -X DELETE http://127.0.0.1:%EUREKA_PORT%/eureka/apps/$($a.name)/$($i.instanceId) ^
             } ^
           } ^
         }"
        '''
      }
    }

    stage('Wait For Registry Update') {
      steps { sleep time: 15, unit: 'SECONDS' }
    }

    stage('Refresh Checkboxes') {
      steps {
        script { build job: env.JOB_NAME, wait: false }
      }
    }
  }
}
