pipeline {
  agent any

  stages {

    stage('Clean Workspace') {
      steps {
        deleteDir()
      }
    }

    // -------------------------------------------------
    // Clone ONLY EurekaServer
    // -------------------------------------------------
    stage('Clone EurekaServer Repo') {
      steps {
        dir('eureka') {
          git url: 'https://github.com/Adrineel-Saha/EurekaServer.git', branch: 'main'
        }
      }
    }

    // -------------------------------------------------
    // Read Eureka server.port from application.yml
    // (✅ ORIGINAL REGEX RESTORED)
    // -------------------------------------------------
    stage('Read Eureka Port from application.yml') {
      steps {
        script {
          def yml = readFile('eureka/src/main/resources/application.yml')

          // ✅ Original, approved regex
          def m = (yml =~ /(?m)^server:\s*(?:\r?\n|\r)\s*port:\s*(\d+)\s*$/)

          if (!m.find()) {
            error "server.port not found in Eureka application.yml"
          }

          env.EUREKA_PORT = m.group(1)
          echo "Eureka port from repo: ${env.EUREKA_PORT}"
        }
      }
    }

    // -------------------------------------------------
    // Fetch Eureka registry (XML – native format)
    // -------------------------------------------------
    stage('Fetch Eureka Registry') {
      steps {
        bat '''
          @echo on
          curl -s http://localhost:%EUREKA_PORT%/eureka/apps > apps.xml
        '''
      }
    }

    // -------------------------------------------------
    // Create checkboxes for ALL services (FIRST RUN)
    // -------------------------------------------------
    stage('Create Service Checkboxes') {
      steps {
        script {
          def xmlText = readFile('apps.xml')
          def root = new XmlSlurper().parseText(xmlText)

          def paramsList = []

          root.application.each { app ->
            def name = app.name.text().toUpperCase()
            paramsList << booleanParam(
              name: "KILL_${name}",
              defaultValue: false,
              description: "Kill all instances of ${name}"
            )
          }

          properties([parameters(paramsList)])

          echo "Service checkboxes created. Re-run the job using 'Build with Parameters'."
          currentBuild.result = 'SUCCESS'
          return
        }
      }
    }

    // -------------------------------------------------
    // Resolve selected instances (SECOND RUN)
    // -------------------------------------------------
    stage('Resolve Selected Instances') {
      steps {
        script {
          def xmlText = readFile('apps.xml')
          def root = new XmlSlurper().parseText(xmlText)

          def targets = []

          root.application.each { app ->
            def appName = app.name.text().toUpperCase()
            if (params["KILL_${appName}"]) {
              app.instance.each { inst ->
                def port = inst.port.text()
                def instanceId = inst.instanceId.text()
                targets << "${appName}|${port}|${instanceId}"
              }
            }
          }

          writeFile file: 'targets.txt', text: targets.join('\n')
          env.HAS_TARGETS = targets ? 'yes' : ''
        }
      }
    }

    // -------------------------------------------------
    // Kill OS processes by PORT
    // -------------------------------------------------
    stage('Kill Processes') {
      when { expression { env.HAS_TARGETS == 'yes' } }
      steps {
        bat '''
          @echo on
          for /f "tokens=1,2,3 delims=|" %%A in (targets.txt) do (
            echo Killing %%A on port %%B
            for /f "tokens=5" %%P in (
              'netstat -ano -p tcp ^| findstr LISTENING ^| findstr :%%B'
            ) do taskkill /F /PID %%P >nul 2>&1
          )
        '''
      }
    }

    // -------------------------------------------------
    // Deregister instances from Eureka
    // -------------------------------------------------
    stage('Deregister from Eureka') {
      when { expression { env.HAS_TARGETS == 'yes' } }
      steps {
        bat '''
          @echo on
          for /f "tokens=1,2,3 delims=|" %%A in (targets.txt) do (
            curl -s -X DELETE ^
              http://localhost:%EUREKA_PORT%/eureka/apps/%%A/%%C >nul 2>&1
          )
        '''
      }
    }
  }

  post {
    always {
      echo "KillInstances pipeline finished (XML-only, original regex restored)."
    }
  }
}
