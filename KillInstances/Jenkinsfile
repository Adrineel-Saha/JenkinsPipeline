pipeline {
  agent any

  stages {

    stage('Clean Workspace') {
      steps { deleteDir() }
    }

    stage('Clone EurekaServer Repo') {
      steps {
        dir('eureka') {
          git url: 'https://github.com/Adrineel-Saha/EurekaServer.git', branch: 'main'
        }
      }
    }

    stage('Read Eureka Port from application.yml') {
      steps {
        script {
          def yml = readFile('eureka/src/main/resources/application.yml')
          def m = (yml =~ /(?m)^server:\s*(?:\r?\n|\r)\s*port:\s*(\d+)\s*$/)
          if (!m.find()) error "server.port not found"
          env.EUREKA_PORT = m.group(1)
          echo "Eureka port: ${env.EUREKA_PORT}"
        }
      }
    }

    stage('Fetch Eureka Registry (XML)') {
      steps {
        bat '''
          curl -s http://localhost:%EUREKA_PORT%/eureka/apps > apps.xml
        '''
      }
    }

    // -------------------------------------------------
    // ✅ CREATE CHECKBOXES: EUREKA + SERVICES (FIXED)
    // -------------------------------------------------
    stage('Create Service Checkboxes') {
      steps {
        script {

          // ✅ Correct PowerShell XML parsing WITH namespace
          bat '''
            powershell -NoProfile -Command ^
              "[xml]$x = Get-Content apps.xml;" ^
              "$ns = New-Object System.Xml.XmlNamespaceManager($x.NameTable);" ^
              "$ns.AddNamespace('e', 'http://www.netflix.com/eureka');" ^
              "$x.SelectNodes('//e:application/e:name', $ns) | ForEach-Object { $_.InnerText } | Set-Content services.txt"
          '''

          def services = readFile('services.txt')
            .readLines()
            .collect { it.trim().toUpperCase() }
            .unique()

          def paramsList = []

          // ✅ Always add Eureka checkbox
          paramsList << booleanParam(
            name: 'KILL_EUREKA',
            defaultValue: false,
            description: 'Kill Eureka Server'
          )

          // ✅ Add service checkboxes from XML
          services.each { svc ->
            paramsList << booleanParam(
              name: "KILL_${svc}",
              defaultValue: false,
              description: "Kill all instances of ${svc}"
            )
          }

          properties([parameters(paramsList)])

          echo "✅ Checkboxes created (Eureka + services). Re-run using 'Build with Parameters'."
          currentBuild.result = 'SUCCESS'
          return
        }
      }
    }

    // -------------------------------------------------
    // Resolve Selected Instances
    // -------------------------------------------------
    stage('Resolve Selected Instances') {
      steps {
        script {

          bat '''
            powershell -NoProfile -Command ^
              "[xml]$x = Get-Content apps.xml;" ^
              "$ns = New-Object System.Xml.XmlNamespaceManager($x.NameTable);" ^
              "$ns.AddNamespace('e', 'http://www.netflix.com/eureka');" ^
              "$x.SelectNodes('//e:application', $ns) | ForEach-Object { " ^
              "  $app=$_.SelectSingleNode('e:name', $ns).InnerText; " ^
              "  $_.SelectNodes('e:instance', $ns) | ForEach-Object { " ^
              "    \"$app|$($_.SelectSingleNode('e:port', $ns).InnerText)\" " ^
              "  } " ^
              "} | Set-Content all_targets.txt"
          '''

          def selected = []

          if (params.KILL_EUREKA) {
            selected << "EUREKA|${env.EUREKA_PORT}"
          }

          readFile('all_targets.txt').readLines().each { line ->
            def parts = line.split('\\|')
            if (parts.size() == 2) {
              def app = parts[0].toUpperCase()
              def port = parts[1]
              if (params["KILL_${app}"]) {
                selected << "${app}|${port}"
              }
            }
          }

          writeFile file: 'final_targets.txt', text: selected.join('\n')
          env.HAS_TARGETS = selected ? 'yes' : ''
        }
      }
    }

    stage('Kill Processes') {
      when { expression { env.HAS_TARGETS == 'yes' } }
      steps {
        bat '''
          for /f "tokens=1,2 delims=|" %%A in (final_targets.txt) do (
            for /f "tokens=5" %%P in (
              'netstat -ano ^| findstr LISTENING ^| findstr :%%B'
            ) do taskkill /F /PID %%P >nul 2>&1
          )
        '''
      }
    }

    stage('Deregister from Eureka') {
      when { expression { env.HAS_TARGETS == 'yes' } }
      steps {
        bat '''
          for /f "tokens=1,2 delims=|" %%A in (final_targets.txt) do (
            curl -s -X DELETE ^
              http://localhost:%EUREKA_PORT%/eureka/apps/%%A >nul 2>&1
          )
        '''
      }
    }
  }

  post {
    always {
      echo "✅ KillInstances finished successfully (Eureka + PowerShell services combined)."
    }
  }
}
