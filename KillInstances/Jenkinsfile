pipeline {
  agent any

  stages {

    stage('Clean Workspace') {
      steps {
        deleteDir()
      }
    }

    // -------------------------------------------------
    // Clone ONLY EurekaServer
    // -------------------------------------------------
    stage('Clone EurekaServer Repo') {
      steps {
        dir('eureka') {
          git url: 'https://github.com/Adrineel-Saha/EurekaServer.git', branch: 'main'
        }
      }
    }

    // -------------------------------------------------
    // Read Eureka server.port from application.yml
    // -------------------------------------------------
    stage('Read Eureka Port from application.yml') {
      steps {
        script {
          def yml = readFile('eureka/src/main/resources/application.yml')
          def m = (yml =~ /(?m)^server:\s*(?:\r?\n|\r)\s*port:\s*(\d+)\s*$/)
          if (!m.find()) {
            error "server.port not found in Eureka application.yml"
          }
          env.EUREKA_PORT = m.group(1)
          echo "Eureka port from repo: ${env.EUREKA_PORT}"
        }
      }
    }

    // -------------------------------------------------
    // Fetch Eureka registry (bootstrap, JSON forced)
    // Uses machine hostname (NOT localhost)
    // -------------------------------------------------
    stage('Fetch Eureka Registry') {
      steps {
        bat '''
          @echo on
          for /f %%H in ('hostname') do set HOST=%%H
          echo Using host %%HOST%%
          curl -s -H "Accept: application/json" ^
            http://%%HOST%%:%EUREKA_PORT%/eureka/apps > apps.json
        '''
      }
    }

    // -------------------------------------------------
    // Derive Eureka Base URL dynamically (NO hardcoding)
    // -------------------------------------------------
    stage('Derive Eureka Base URL') {
      steps {
        script {
          def apps = new groovy.json.JsonSlurper()
            .parseText(readFile('apps.json'))
            ?.applications
            ?.application

          if (apps instanceof Map) apps = [apps]

          def eurekaApp = apps.find {
            it.name?.toString()?.toUpperCase() == 'EUREKA'
          }
          if (!eurekaApp) {
            error "EUREKA application not found in registry"
          }

          def inst = eurekaApp.instance
          if (inst instanceof List) inst = inst[0]

          env.EUREKA_HOST = inst.hostName.toString()
          env.EUREKA_REG_PORT = inst.port['$'].toString()
          env.EUREKA_BASE_URL = "http://${env.EUREKA_HOST}:${env.EUREKA_REG_PORT}"

          echo "Derived Eureka Base URL: ${env.EUREKA_BASE_URL}"
        }
      }
    }

    // -------------------------------------------------
    // Create checkboxes for ALL services (from Eureka)
    // -------------------------------------------------
    stage('Create Service Checkboxes') {
      steps {
        script {
          def apps = new groovy.json.JsonSlurper()
            .parseText(readFile('apps.json'))
            ?.applications
            ?.application

          if (apps instanceof Map) apps = [apps]

          def paramsList = []
          apps.each { app ->
            def name = app.name.toString().toUpperCase()
            paramsList << booleanParam(
              name: "KILL_${name}",
              defaultValue: false,
              description: "Kill all instances of ${name}"
            )
          }

          properties([parameters(paramsList)])
        }
      }
    }

    // -------------------------------------------------
    // Resolve selected instances (ports from Eureka)
    // -------------------------------------------------
    stage('Resolve Selected Instances') {
      steps {
        script {
          def apps = new groovy.json.JsonSlurper()
            .parseText(readFile('apps.json'))
            ?.applications
            ?.application

          if (apps instanceof Map) apps = [apps]

          def targets = []

          apps.each { app ->
            def appName = app.name.toString().toUpperCase()
            if (params["KILL_${appName}"]) {
              def insts = app.instance
              if (insts instanceof Map) insts = [insts]

              insts.each { inst ->
                def port = inst.port['$'].toString()
                targets << "${appName}|${port}|${inst.instanceId}"
              }
            }
          }

          writeFile file: 'targets.txt', text: targets.join('\n')
          env.HAS_TARGETS = targets ? 'yes' : ''
        }
      }
    }

    // -------------------------------------------------
    // Kill OS processes by PORT
    // -------------------------------------------------
    stage('Kill Processes') {
      when { expression { env.HAS_TARGETS == 'yes' } }
      steps {
        bat '''
          @echo on
          for /f "tokens=1,2,3 delims=|" %%A in (targets.txt) do (
            echo Killing %%A on port %%B
            for /f "tokens=5" %%P in (
              'netstat -ano -p tcp ^| findstr LISTENING ^| findstr :%%B'
            ) do taskkill /F /PID %%P >nul 2>&1
          )
        '''
      }
    }

    // -------------------------------------------------
    // Deregister instances from Eureka (NO hardcoding)
    // -------------------------------------------------
    stage('Deregister from Eureka') {
      when { expression { env.HAS_TARGETS == 'yes' } }
      steps {
        bat '''
          @echo on
          for /f "tokens=1,2,3 delims=|" %%A in (targets.txt) do (
            curl -s -X DELETE ^
              %EUREKA_BASE_URL%/eureka/apps/%%A/%%C >nul 2>&1
          )
        '''
      }
    }
  }

  post {
    always {
      echo "KillInstances completed with NO hardcoded Eureka host or port."
    }
  }
}
