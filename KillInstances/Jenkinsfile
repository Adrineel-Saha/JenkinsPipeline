pipeline {
  agent any

  /* =========================================================
     PARAMETERS
     ========================================================= */
  parameters {

    booleanParam(name: 'KILL_EUREKA',        defaultValue: false, description: 'Kill Eureka Server')
    booleanParam(name: 'KILL_CONFIGSERVER',  defaultValue: false, description: 'Kill Config Server (8888)')
    booleanParam(name: 'KILL_APIGATEWAY',    defaultValue: false, description: 'Kill API Gateway (9191)')

    booleanParam(name: 'KILL_USERSERVICE',   defaultValue: false, description: 'Kill UserService')
    string(name: 'USERSERVICE_PORTS',        defaultValue: '',    description: 'e.g. 8080,8085')

    booleanParam(name: 'KILL_PRODUCTSERVICE',defaultValue: false, description: 'Kill ProductService')
    string(name: 'PRODUCTSERVICE_PORTS',     defaultValue: '',    description: 'e.g. 8081,8083')

    booleanParam(name: 'KILL_ORDERSERVICE',  defaultValue: false, description: 'Kill OrderService')
    string(name: 'ORDERSERVICE_PORTS',       defaultValue: '',    description: 'e.g. 8082')
  }

  stages {

    /* =========================================================
       RESOLVE EUREKA PORT
       ========================================================= */
    stage('Resolve Eureka Port') {
      steps {
        dir('eureka') {
          git url: 'https://github.com/Adrineel-Saha/EurekaServer.git', branch: 'main'
        }
        script {
          def yml = readFile('eureka/src/main/resources/application.yml')

          // ✅ REVERTED STRICT REGEX
          def m = (yml =~ /(?m)^server:\s*(?:\r?\n|\r)\s*port:\s*(\d+)/)

          if (!m.find()) {
            error 'Eureka port not found'
          }

          env.EUREKA_PORT = m.group(1)
          echo "✅ Eureka port = ${env.EUREKA_PORT}"
        }
      }
    }

    stage('Fetch Eureka Registry') {
      steps {
        bat "curl -s http://localhost:%EUREKA_PORT%/eureka/apps > apps.xml"
      }
    }

    /* =========================================================
       KILL SERVICES — JAR + PORT, GRACEFUL THEN HARD
       ========================================================= */
    stage('Graceful Kill Services') {
      steps {
        bat '''
          @echo on

          call :KILL UserService UserService.jar "%USERSERVICE_PORTS%" "%KILL_USERSERVICE%"
          call :KILL ProductService ProductService.jar "%PRODUCTSERVICE_PORTS%" "%KILL_PRODUCTSERVICE%"
          call :KILL OrderService OrderService.jar "%ORDERSERVICE_PORTS%" "%KILL_ORDERSERVICE%"
          exit /b 0

          :KILL
          set NAME=%1
          set JAR=%2
          set PORTS=%3
          set ENABLED=%4

          if not "%ENABLED%"=="true" goto :eof
          if "%PORTS%"=="" goto :eof

          for %%P in (%PORTS:,= %) do (
            echo === %NAME% | Port %%P ===

            for /f "tokens=2 delims== " %%X in ('
              wmic process where "CommandLine like '%%!JAR!%%' and CommandLine like '%%--server.port=%%P%%'" get ProcessId /value
            ') do (
              echo Graceful stop PID %%X
              taskkill /PID %%X >nul 2>&1
              timeout /t 5 >nul
              taskkill /F /PID %%X >nul 2>&1
            )
          )
          goto :eof
        '''
      }
    }

    /* =========================================================
       BEST‑EFFORT EUREKA CLEANUP
       ========================================================= */
    stage('Best Effort Eureka Deregister') {
      steps {
        bat '''
          @echo on

          (
            echo [xml]$apps = Get-Content "apps.xml"
            echo $ports = "%USERSERVICE_PORTS%,%PRODUCTSERVICE_PORTS%,%ORDERSERVICE_PORTS%".Split(',') ^| Where-Object { $_ -ne "" }
            echo foreach ($a in $apps.applications.application) {
            echo   foreach ($i in $a.instance) {
            echo     if ($ports -contains $i.port.'#text') {
            echo       curl -s -X DELETE http://localhost:%EUREKA_PORT%/eureka/apps/$($a.name)/$($i.instanceId)
            echo     }
            echo   }
            echo }
          ) > cleanup.ps1

          powershell -NoProfile -ExecutionPolicy Bypass -File cleanup.ps1
          exit /b 0
        '''
      }
    }

    /* =========================================================
       INFRASTRUCTURE
       ========================================================= */
    stage('Kill Infrastructure') {
      steps {
        bat '''
          if "%KILL_CONFIGSERVER%"=="true" (
            for /f "tokens=5" %%P in ('netstat -ano ^| findstr :8888') do taskkill /F /PID %%P >nul
          )
          if "%KILL_APIGATEWAY%"=="true" (
            for /f "tokens=5" %%P in ('netstat -ano ^| findstr :9191') do taskkill /F /PID %%P >nul
          )
          if "%KILL_EUREKA%"=="true" (
            for /f "tokens=5" %%P in ('netstat -ano ^| findstr :%EUREKA_PORT%') do taskkill /F /PID %%P >nul
          )
          exit /b 0
        '''
      }
    }
  }

  post {
    always {
      echo '✅ KillInstances pipeline completed (graceful‑then‑hard strategy)'
    }
  }
}
