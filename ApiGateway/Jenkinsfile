pipeline {
  agent any

  environment {
    JDK_HOME = tool name: 'JDK17', type: 'jdk'
    MVN_HOME = tool name: 'Maven3', type: 'maven'
    // GATEWAY_PORT will be read from application.yml
  }

  stages {

    stage('Clone Repository') {
      steps {
        git url: 'https://github.com/Adrineel-Saha/ApiGateway.git', branch: 'main'
      }
    }

    // ---------------------------------------
    // ✅ Read server.port from application.yml
    // ---------------------------------------
    stage('Read Port from application.yml') {
      steps {
        script {
          def ymlPath = 'src/main/resources/application.yml'
          if (!fileExists(ymlPath)) {
            error "application.yml not found at ${ymlPath}"
          }

          def yml = readFile ymlPath
          def m = (yml =~ /(?m)^server:\\s*(?:\\r?\\n|\\r)\\s*port:\\s*(\\d+)\\s*$/)

          if (m.find()) {
            env.GATEWAY_PORT = m.group(1)
            echo "Using server.port from application.yml: ${env.GATEWAY_PORT}"
          } else {
            error "server.port not found in application.yml"
          }
        }
      }
    }

    // ---------------------------------------
    // ✅ SAFE FIX — Kill ApiGateway by JAR name (NOT by port)
    // ---------------------------------------
    stage('Kill Old Instance') {
      steps {
        bat '''
          @echo on
          echo === Killing existing ApiGateway instances by JAR name ===

          for /f "skip=1 tokens=2 delims== " %%P in (
            'wmic process where "CommandLine like '%%ApiGateway.jar%%'" get ProcessId /value'
          ) do (
            echo Killing ApiGateway PID %%P
            taskkill /F /PID %%P >nul 2>&1
          )

          echo === Kill stage completed ===
          exit /b 0
        '''
      }
    }

    // ---------------------------------------
    // ✅ Build (wrapper-first)
    // ---------------------------------------
    stage('Build') {
      steps {
        withEnv([
          "JAVA_HOME=${env.JDK_HOME}",
          "M2_HOME=${env.MVN_HOME}",
          "PATH+JAVA=${env.JDK_HOME}\\bin",
          "PATH+MAVEN=${env.MVN_HOME}\\bin",
          "MAVEN_OPTS=-Xmx1024m -Dfile.encoding=UTF-8"
        ]) {
          script {
            bat 'echo === Build: env check ==='
            bat '"%JAVA_HOME%\\bin\\java.exe" -version'
            bat '"%M2_HOME%\\bin\\mvn.cmd" -v'

            def mvnCmd = fileExists('mvnw.cmd')
              ? 'mvnw.cmd'
              : '"%M2_HOME%\\bin\\mvn.cmd"'

            bat 'if exist target rmdir /s /q target'
            bat "call ${mvnCmd} -B -e -U clean package"

            bat 'if not exist target\\*.jar (echo ERROR: No jar produced & exit /b 1)'
          }
        }
      }
    }

    // ---------------------------------------
    // ✅ Run ApiGateway (port-known)
    // ---------------------------------------
    stage('Run ApiGateway') {
      steps {
        withEnv([
          "JAVA_HOME=${env.JDK_HOME}",
          "PATH+JAVA=${env.JDK_HOME}\\bin"
        ]) {
          bat '''
            @echo on
            setlocal enabledelayedexpansion

            echo === Resolve JAR ===
            for %%f in (target\\*.jar) do (
              set "SRC_JAR=%%~ff"
              goto :found
            )
            echo ERROR: No jar found
            exit /b 1
            :found

            if exist run rmdir /s /q run
            mkdir run
            copy /Y "%SRC_JAR%" run\\ApiGateway.jar

            rem Prevent Jenkins from killing it
            set BUILD_ID=dontKillMe
            set JENKINS_NODE_COOKIE=do_not_kill

            echo === Starting ApiGateway on port %GATEWAY_PORT% ===
            start "" /b "%JAVA_HOME%\\bin\\java.exe" ^
              -jar "%CD%\\run\\ApiGateway.jar" ^
              --server.port=%GATEWAY_PORT%

            echo === Waiting for HTTP readiness ===
            set COUNT=0
            :wait_loop
            set /a COUNT+=1
            ping -n 2 127.0.0.1 >nul
            curl -s -o NUL http://127.0.0.1:%GATEWAY_PORT%/
            if not errorlevel 1 goto up
            if %COUNT% GEQ 60 goto fail
            goto wait_loop

            :up
            echo SUCCESS: ApiGateway is running on port %GATEWAY_PORT%
            exit /b 0

            :fail
            echo ERROR: ApiGateway did not start within 60 seconds
            exit /b 1
          '''
        }
      }
    }
  }

  post {
    always {
      echo "✅ ApiGateway running in background on port ${env.GATEWAY_PORT}"
    }
  }
}
